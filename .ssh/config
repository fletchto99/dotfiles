Include config.github
Include config.rogue

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentityFile ~/.ssh/ultron_ed25519.pub
  IdentitiesOnly yes
  # Keep long-lived sessions (bastions etc.) from silently dying behind NAT.
  ServerAliveInterval 60
  # Multiplex connections; %C hashes host/port/user (avoids the socket
  # path-length limit) and ~/.ssh is user-only unlike world-writable /tmp.
  # ControlPersist keeps the master alive after the first session exits so
  # rapid consecutive connections (e.g. repeated git pushes) actually reuse it.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
